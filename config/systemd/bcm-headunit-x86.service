[Unit]
Description=BCM v8.5 — Alfa Romeo 156 Head Unit
Documentation=https://github.com/geek95dg/Alfa156-headunit
After=network.target sound.target

# Started/stopped by bcm-ignition-watcher.service
PartOf=bcm-ignition-watcher.service

[Service]
Type=simple

# Base config (tracked in git, never written by BCM). Runtime changes from
# the UI go to config/local.yaml next to it. To switch or roll back, set
# BCM_CONFIG in /etc/bcm/bcm.env — EnvironmentFile overrides Environment=,
# so e.g. BCM_CONFIG=config/bcm_config_temp.yaml restores the old file.
#   OPi PC (archived): --platform opi_pc, BCM_CONFIG=Archive/orange-pi-pc/bcm_config_opi_pc.yaml
Environment=BCM_CONFIG=config/bcm_config_test.yaml
# Secrets (API keys, passwords), root:root 0600 — see config/bcm.env.example.
# The leading '-' keeps a missing file from blocking the start.
EnvironmentFile=-/etc/bcm/bcm.env

# Resolve venv path (.venv or venv).
# Quoting: "$VENV" sits inside the single-quoted bash -c word, where systemd
# does not expand braceless variables, so bash sees it as written. The
# config path uses "$$" because systemd itself WOULD expand "${...}" inside
# a word: "$$" is systemd's escape for a literal "$", so bash receives
# "${BCM_CONFIG:-...}" and the fallback still applies if the variable is unset.
ExecStart=/bin/bash -c 'VENV=/opt/bcm/.venv; [ -x "$VENV/bin/python" ] || VENV=/opt/bcm/venv; exec "$VENV/bin/python" main.py --platform x86 --config "$${BCM_CONFIG:-config/bcm_config_test.yaml}" --frontend'
WorkingDirectory=/opt/bcm
Environment=PYTHONPATH=/opt/bcm
Environment=BCM_PLATFORM=x86

TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM

# Auto-restart on crash. A clean 'systemctl stop' from the ignition
# watcher does NOT trigger this (on-failure only), so the watcher still
# owns the normal lifecycle; the ignition watcher additionally has a
# liveness check as a second layer.
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=4

User=root
SupplementaryGroups=audio video

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bcm-headunit

[Install]
# Not in WantedBy — started by ignition watcher, not at boot
