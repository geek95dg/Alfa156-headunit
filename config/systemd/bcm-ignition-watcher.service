[Unit]
Description=BCM — Ignition Watcher (GPIO monitor, starts headunit on ignition)
Documentation=https://github.com/geek95dg/Alfa156-headunit
After=multi-user.target bluetooth.target bcm-bluetooth.service

[Service]
Type=simple

# Same base config as bcm-headunit (only power.* is read here); override
# it with BCM_CONFIG in /etc/bcm/bcm.env, which wins over Environment=.
# For OPi PC (archived): BCM_CONFIG=Archive/orange-pi-pc/bcm_config_opi_pc.yaml
Environment=BCM_CONFIG=config/bcm_config_test.yaml
EnvironmentFile=-/etc/bcm/bcm.env

# Resolve the Python venv at service-start time — honour both
# /opt/bcm/.venv (current manual) and /opt/bcm/venv (older clones).
# "$$" is systemd's escape for a literal "$" (see bcm-headunit-x86.service):
# bash, not systemd, expands ${BCM_CONFIG:-...}.
ExecStart=/bin/bash -c 'VENV=/opt/bcm/.venv; [ -x "$VENV/bin/python" ] || VENV=/opt/bcm/venv; exec "$VENV/bin/python" -m src.power.ignition_watcher --config "$${BCM_CONFIG:-config/bcm_config_test.yaml}" --autostart --service bcm-headunit.service'
WorkingDirectory=/opt/bcm
Environment=PYTHONPATH=/opt/bcm

Restart=always
RestartSec=5

# Run as root for GPIO access and systemctl permissions
User=root

# Logging via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bcm-ignition-watcher

[Install]
WantedBy=multi-user.target
