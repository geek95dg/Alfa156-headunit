[Unit]
Description=BCM — Resume from suspend (handled by /lib/systemd/system-sleep/bcm-sleep)
# This unit is intentionally a no-op kept for upgrade compatibility.
# All pre-suspend / post-resume logic now lives in the system-sleep hook
# so it runs regardless of how suspend was triggered. Disable cleanly:
#   systemctl disable bcm-resume.service

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
