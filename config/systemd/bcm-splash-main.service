[Unit]
Description=BCM Boot Splash — drives both displays from one process
Documentation=https://github.com/geek95dg/Alfa156-headunit
DefaultDependencies=no

# Run after udev settles (so /dev/dri/card0 exists) but before the BCM
# headunit so the splash owns DRM master before mpv/X try to take it.
# Earlier attempt put this Before=sysinit.target with DefaultDependencies=no —
# that scheduled the unit so early that DRM wasn't yet attached and the
# script silently exited, leaving a long black screen between grub and
# xinit. Stay in the normal multi-user ordering and we get an mpv frame
# within ≈1 s of card0 appearing on Lenovo M910q + OPi 5 Pro both.
After=systemd-vconsole-setup.service systemd-udev-settle.service
Before=multi-user.target bcm-ignition-watcher.service bcm-headunit.service

ConditionPathExists=/opt/bcm/assets/splash/small.mp4

[Service]
Type=simple

# Connectors are AUTO-DETECTED from /sys/class/drm — the splash plays on
# every CONNECTED connector, so no per-platform connector config is needed.
# (Old builds hardcoded HDMI-A-1, which is disconnected on the M910q — the
# panel is HDMI-A-2 — so the splash silently vanished.) BCM_SPLASH_DRM_MAIN
# is now only an optional "prefer this connector first" hint; leave it empty
# for pure auto-detect. A disconnected hint is ignored, never fatal.
Environment=BCM_SPLASH_DRM_MAIN=
Environment=BCM_SPLASH_VIDEO=/opt/bcm/assets/splash/small.mp4
# Splash now exits exactly when the kiosk is ready (App.init posts to
# /api/ready). Keep the visible floor at 0 so users see BCM the moment
# Chromium paints — no padding. Override to a positive number only if
# you want the splash to linger for branding reasons.
Environment=BCM_SPLASH_MIN_SECONDS=0
Environment=BCM_SPLASH_READY_URL=http://localhost:5002/api/ready
Environment=BCM_SPLASH_FALLBACK_URL=http://localhost:5002

# Single helper process: mpv on the main connector via DRM. The small
# connector is left to the kernel framebuffer / xinit handoff — the
# previous dual-kmssink gst-launch path failed to publish frames on
# baremetal and the user saw a black main screen for the whole boot.
ExecStart=/usr/local/bin/bcm-splash-play.sh
ExecStop=/bin/bash -c 'pkill -f bcm-splash-play.sh 2>/dev/null; pkill -f "mpv.*splash" 2>/dev/null; true'

SuccessExitStatus=0 1 SIGTERM
Restart=no

User=root
Environment=XDG_RUNTIME_DIR=/run/user/0
SupplementaryGroups=video audio

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bcm-splash-main

[Install]
WantedBy=multi-user.target
