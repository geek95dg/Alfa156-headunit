[Unit]
Description=BCM Boot Splash — plays until dashboard is ready
Documentation=https://github.com/geek95dg/Alfa156-headunit
DefaultDependencies=no

# Start early, before BCM stack. sound.target ensures ALSA cards are ready.
After=systemd-vconsole-setup.service sound.target
Before=multi-user.target bcm-ignition-watcher.service

ConditionPathExists=/opt/bcm/assets/splash/main.mp4

[Service]
Type=simple

# DRM connector for the main display. Override per platform:
#   M910q (DP-to-HDMI): HDMI-1 or HDMI-2
#   OPi 5 Pro (2× HDMI): HDMI-A-1
#   Override: systemctl edit bcm-splash-main → [Service] Environment=BCM_SPLASH_DRM_MAIN=HDMI-A-1
Environment=BCM_SPLASH_DRM_MAIN=

ExecStart=/bin/bash -c '\
    MPV=$(command -v mpv 2>/dev/null); \
    if [ -z "$MPV" ]; then exit 0; fi; \
    DRM_ARG=""; \
    [ -n "$BCM_SPLASH_DRM_MAIN" ] && DRM_ARG="--drm-connector=$BCM_SPLASH_DRM_MAIN"; \
    "$MPV" --fs --loop-file=inf --really-quiet \
        --vo=drm,gpu,sdl \
        --hwdec=auto \
        $DRM_ARG \
        --ao=alsa,pipewire,pulse \
        --input-conf=/dev/null \
        /opt/bcm/assets/splash/main.mp4 & \
    MPV_PID=$!; \
    for i in $(seq 1 120); do \
        if curl -sf http://localhost:5002 >/dev/null 2>&1; then \
            sleep 5; \
            kill $MPV_PID 2>/dev/null; \
            exit 0; \
        fi; \
        sleep 1; \
    done; \
    kill $MPV_PID 2>/dev/null; \
    exit 0'

ExecStop=/bin/bash -c 'pkill -f "mpv.*splash" 2>/dev/null; true'

SuccessExitStatus=0 1
Restart=no

User=root
Environment=XDG_RUNTIME_DIR=/run/user/0
SupplementaryGroups=video audio

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bcm-splash-main

[Install]
WantedBy=multi-user.target
