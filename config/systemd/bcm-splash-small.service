[Unit]
Description=BCM Boot Splash — small display (DEPRECATED, kept for migration)
Documentation=https://github.com/geek95dg/Alfa156-headunit
DefaultDependencies=no

# DEPRECATED: bcm-splash-main now drives BOTH connectors from one
# gst-launch — a video pipeline on the main and a black videotestsrc on
# the small one. This unit used to fight for drmSetMaster on card0; it
# is intentionally left in the repo as a no-op so an old `systemctl
# enable bcm-splash-small` from a previous install still boots cleanly.
# bcm-splash-main is the single source of truth.

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=no

[Install]
# Not in any WantedBy — must not auto-start.
